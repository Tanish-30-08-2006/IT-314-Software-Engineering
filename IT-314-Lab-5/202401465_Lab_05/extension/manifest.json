{
  "manifest_version": 3,
  "name": "LiveReq - LangChain Edition",
  "version": "2.0",
  "description": "Real-time AI requirement analysis powered by LangChain backend.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open LiveReq Analyst"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"]
    }
  ]
}
